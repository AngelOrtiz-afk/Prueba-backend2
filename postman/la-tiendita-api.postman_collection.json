{
  "info": {
    "_postman_id": "d0d42b7a-5e1d-4c83-bb86-7c4c6b3cf001",
    "name": "La Tiendita API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "base_url", "value": "http://127.0.0.1:8000/api/v1"},
    {"key": "username", "value": "usuario"},
    {"key": "password", "value": "contraseña"},
    {"key": "producto_id", "value": ""},
    {"key": "venta_id", "value": ""}
  ],
  "item": [
    {
      "name": "Listar productos",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/productos/"
      }
    },
    {
      "name": "Crear producto",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "auth": {"type": "basic", "basic": [
          {"key": "username", "value": "{{username}}", "type": "string"},
          {"key": "password", "value": "{{password}}", "type": "string"}
        ]},
        "body": {"mode": "raw", "raw": "{\"nombre\":\"Producto Postman\",\"descripcion\":\"Demo\",\"precio\":100,\"stock\":10,\"activo\":true}"},
        "url": "{{base_url}}/productos/"
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Producto creado', function () { pm.response.to.have.status(201); });",
        "pm.collectionVariables.set('producto_id', pm.response.json().id);"
      ]}}]
    },
    {
      "name": "Crear venta",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "auth": {"type": "basic", "basic": [
          {"key": "username", "value": "{{username}}", "type": "string"},
          {"key": "password", "value": "{{password}}", "type": "string"}
        ]},
        "body": {"mode": "raw", "raw": "{\"cliente\":\"Cliente Postman\",\"detalles\":[{\"producto\":{{producto_id}},\"cantidad\":2}]}"},
        "url": "{{base_url}}/ventas/"
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Venta creada', function () { pm.response.to.have.status(201); });",
        "pm.collectionVariables.set('venta_id', pm.response.json().id);"
      ]}}]
    },
    {
      "name": "Verificar stock",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {"type": "basic", "basic": [
          {"key": "username", "value": "{{username}}", "type": "string"},
          {"key": "password", "value": "{{password}}", "type": "string"}
        ]},
        "url": "{{base_url}}/productos/{{producto_id}}/"
      }
    },
    {
      "name": "Eliminar venta",
      "request": {
        "method": "DELETE",
        "header": [],
        "auth": {"type": "basic", "basic": [
          {"key": "username", "value": "{{username}}", "type": "string"},
          {"key": "password", "value": "{{password}}", "type": "string"}
        ]},
        "url": "{{base_url}}/ventas/{{venta_id}}/"
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Venta eliminada', function () { pm.response.to.have.status(204); });"
      ]}}]
    }
  ]
}
